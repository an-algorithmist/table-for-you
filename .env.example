# Never commit .env. Environment variables override this file.
DATABASE_URL=postgres://nebula:nebula_local_only@localhost:5432/nebula?sslmode=disable
GEMINI_API_KEY=
TAVILY_API_KEY=
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.1-flash-lite
PORT=8080
# localhost permits entering with an empty code; hosted mode requires a code.
APP_ENV=local
REVIEWER_ACCESS_CODE=
MAX_DAILY_RUNS_PER_OWNER=20
MAX_DAILY_RUNS_GLOBAL=100
# JWT signup/signin is deferred. This build uses owner-scoped guest sessions.

# Optional paid Google-grounded route (same server-side Gemini key)
ENABLE_GOOGLE_GROUNDED=true
GROUNDED_MODEL_NAME=gemini-3.8-flash
MAX_DAILY_GROUNDED_PER_OWNER=3
MAX_DAILY_GROUNDED_GLOBAL=10
GROUNDED_MAX_OUTPUT_TOKENS=8192

# Hard cap across plain, grounded and visual model attempts (default 9, maximum 20).
MAX_MODEL_CALLS_PER_RUN=9
